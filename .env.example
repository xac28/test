# ── Core ────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/aya"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # public address: canonical links, sitemap, social cards, password-reset links
AUTH_SECRET="change-me"          # openssl rand -base64 32
AUTH_TRUST_HOST="true"
ADMIN_EMAIL="admin@example.com"   # this account is promoted to ADMIN automatically
CRON_SECRET="change-me"           # protects /api/cron/* (cleanup, bookings, reminders, digests, shop)

# ── Live video (LiveKit) ────────────────────────────────────────────────
# LIVEKIT_URL is what the BROWSER connects to — it must be reachable from users (wss://… in production)
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# ── Lesson recordings ───────────────────────────────────────────────────
# Private folder for recordings (default: ./storage/recordings). Not served statically.
# RECORDINGS_DIR="/var/lib/aya/recordings"

# ── Payments / auth providers / mail / AI (optional in development) ─────
STRIPE_SECRET_KEY="sk_test_dummy"
STRIPE_WEBHOOK_SECRET="whsec_dummy"
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SMTP_USER=""                     # without SMTP, password-reset links are only printed to the server console (development)
SMTP_PASS=""
SHOP_ACCOUNT_NAME=""               # shown to customers who pay by bank transfer
SHOP_IBAN=""
GEMINI_API_KEY=""

# Require a verified e-mail address for applying to teach, booking, enrolling and posting (run scripts/verify-existing-users.js first on an existing site)
REQUIRE_EMAIL_VERIFICATION="false"

# Build-time switches (set them when running `next build`)
CSP_MODE="report-only"      # report-only | enforce | off — see README
ENABLE_HSTS="false"          # true only when the site is served over HTTPS

# ── docker compose (see docker-compose.yml / DEPLOY.md) ──────────────────
DB_ROOT_PASSWORD="change-me-root"
DB_PASSWORD="change-me-db"
LIVEKIT_PUBLIC_URL="ws://localhost:7880"   # what browsers connect to (wss://live.example.com in production)
AUTO_DB_PUSH="true"                          # container start syncs the schema (never destructive)

# ── AI guide (Claude) — leave ANTHROPIC_API_KEY empty to keep the rule-based guide ──
ANTHROPIC_API_KEY=""
# AYA_AI_MODEL="claude-opus-5-5"
# AYA_AI_DAILY_TOKENS="3000000"   # daily token budget; above it the guide falls back to rules
# AYA_AI_VISITOR_DAILY="40"       # questions per visitor (IP) per day
# AYA_AI_USER_DAILY="150"         # questions per signed-in member per day
# AYA_AI_DISABLED="1"
